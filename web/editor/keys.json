{
  "about": "The editor's keys. A scope's keys win while that panel is the active one; 'editor' is always on in the Edit tab; 'app' works in every tab. A key means one thing everywhere: a scope may add keys, never give an 'editor' key another meaning (keys.test.js checks). A focused text box keeps all its keys. Names: lower-case key, with ctrl+ / shift+ / alt+ in front (ctrl also means Cmd on a Mac). 'groups' and 'labels' are what the ? overlay shows.",
  "scopes": {
    "app": {
      "?": "showKeys"
    },
    "editor": {
      "space": "playPause",
      "j": "shuttleBack",
      "k": "pause",
      "l": "shuttleForward",
      "left": "frameBack",
      "right": "frameForward",
      "shift+left": "secondBack",
      "shift+right": "secondForward",
      "home": "toStart",
      "end": "toEnd",
      "\\": "beforeAfter",
      "i": "markIn",
      "o": "markOut",
      "ctrl+shift+x": "clearMarks",
      "delete": "strikeSelection",
      "backspace": "strikeSelection",
      "shift+delete": "rippleDelete",
      "b": "blade",
      ",": "trimBack",
      ".": "trimForward",
      "esc": "cancelBox",
      "up": "prevCut",
      "down": "nextCut",
      "c": "keep",
      "r": "restore",
      "=": "zoomIn",
      "+": "zoomIn",
      "-": "zoomOut",
      "shift+z": "zoomFit",
      "s": "toggleSnap",
      "ctrl+z": "undo",
      "ctrl+shift+z": "redo",
      "ctrl+y": "redo"
    },
    "cuts": {
      "n": "note",
      "enter": "playCut"
    }
  },
  "groups": [
    { "title": "Play", "actions": ["playPause", "shuttleBack", "pause", "shuttleForward", "frameBack", "frameForward", "secondBack", "secondForward", "toStart", "toEnd", "beforeAfter"] },
    { "title": "Cuts", "actions": ["prevCut", "nextCut", "keep", "restore", "note", "playCut"] },
    { "title": "Edit", "actions": ["markIn", "markOut", "clearMarks", "strikeSelection", "rippleDelete", "blade", "trimBack", "trimForward", "cancelBox", "undo", "redo"] },
    { "title": "Timeline", "actions": ["zoomIn", "zoomOut", "zoomFit", "toggleSnap"] },
    { "title": "Anywhere", "actions": ["showKeys"] }
  ],
  "labels": {
    "showKeys": "Show these keys",
    "playPause": "Play / pause",
    "shuttleBack": "Play backwards (again: faster)",
    "pause": "Pause",
    "shuttleForward": "Play forwards (again: faster)",
    "frameBack": "One frame back",
    "frameForward": "One frame on",
    "secondBack": "One second back",
    "secondForward": "One second on",
    "toStart": "To the start",
    "toEnd": "To the end",
    "beforeAfter": "Before / After",
    "markIn": "Mark In",
    "markOut": "Mark Out",
    "clearMarks": "Clear In and Out",
    "strikeSelection": "Cut the selected words, or In to Out",
    "rippleDelete": "Ripple delete In to Out",
    "blade": "Blade at the playhead",
    "trimBack": "Move the join a frame earlier",
    "trimForward": "Move the join a frame later",
    "cancelBox": "Cancel the box you are drawing",
    "prevCut": "Previous cut",
    "nextCut": "Next cut",
    "keep": "Keep cut: the cut stays, its words stay out",
    "restore": "Restore words: the cut words come back",
    "note": "A note on the cut (Cuts list)",
    "playCut": "Hear the cut, Before and After (Cuts list)",
    "zoomIn": "Zoom in",
    "zoomOut": "Zoom out",
    "zoomFit": "Fit the whole edit",
    "toggleSnap": "Snap on / off",
    "undo": "Undo",
    "redo": "Redo"
  }
}
